// SPDX-License-Identifier: BSD-3-Clause
/*
 * Lenovo TB371FC (Xiaoxin Pad Pro 12.7) board device tree source
 *
 * Hardware summary:
 *   SoC:    Qualcomm Snapdragon 870 (SM8250-AC / Kona v2.1)
 *   RAM:    8 GB LPDDR5
 *   Storage: UFS (KLUEG4RHGB-B0E1)
 *   Display: Tianma NT36532 DSC 2944x1840 video panel
 *   Touch:  NVT-ts
 *   Audio:  konaqrdsndcard + 4x tfa98xx
 *   Sensors: bmi3x0 (accel/gyro), tcs3408 (als/prox), qmc630x (mag)
 *   Charger: mm8013
 *   WiFi/BT: qca6390
 *   Other:  goodix fingerprint, fsa4480 USB audio switch
 *
 * This dts is intended to be compiled into a self-contained dtb that includes
 * all board-level nodes that are normally supplied by the factory dtbo #07.
 *
 * IMPORTANT:
 *   - Properties marked with "TODO(dtbo#7)" must be filled in by extracting
 *     the corresponding nodes from the stock dtbo image entry #07.
 *   - I2C addresses, GPIO numbers, regulator supplies and panel timings below
 *     are either inferred from public sources or left as placeholders.
 */

/dts-v1/;

#include "kona.dtsi"
#include "kona-pinctrl.dtsi"
#include "kona-pm.dtsi"
#include "kona-regulators.dtsi"
/* 提供 pm8150_gpios / pm8150l 等 PMIC GPIO 与外设节点 (pm8150.dtsi 等) */
#include "kona-pmic-overlay.dtsi"
#include "kona-qupv3.dtsi"
#include "kona-sde-display.dtsi"
/*
 * kona-audio.dtsi 内部包含 msm-audio-lpass.dtsi, 提供 dai_mi2s2 等 DAI 节点。
 * 注意: 不要包含 kona-audio-overlay.dtsi —— 那是 QRD 参考板的
 * wcd938x/wsa881x 方案, TB371FC 实际使用 I2C 总线上的 4x tfa98xx。
 */
#include "kona-audio.dtsi"

/ {
	model = "Lenovo TB371FC Xiaoxin Pad Pro 12.7";
	compatible = "lenovo,tb371fc", "qcom,kona";

	/* Kona v2.1 MSM-ID */
	qcom,msm-id = <0x164 0x20001>;

	/* Board ID must match the value selected by the bootloader.
	 * TODO(dtbo#7): extract qcom,board-id from stock dtb/dtbo #07.
	 */
	qcom,board-id = <0x0 0x0>;

	aliases {
		serial0 = &qupv3_se12_2uart;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/*
		 * 注意: dtc 不支持 C 风格相邻字符串拼接, bootargs 必须写成单行单字符串。
		 * 实际启动参数以 BoardConfig 的 BOARD_KERNEL_CMDLINE 为准, 这里仅作兜底。
		 */
		bootargs = "androidboot.hardware=qcom androidboot.console=ttyMSM0 androidboot.memcg=1 lpm_levels.sleep_disabled=1 msm_rtb.filter=0x237 service_locator.enable=1 androidboot.usbcontroller=a600000.dwc3 swiotlb=2048";
	};

	/* Bootloader will patch the actual memory size. */
	memory {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x0>;
	};

	/* Hardware info node used by some Lenovo-specific drivers. */
	hwinfo: hwinfo {
		compatible = "lenovo,hwinfo";
		model = "TB371FC";
	};
};

/* ------------------------------------------------------------------------
 * Storage
 * ------------------------------------------------------------------------ */

&ufshc_mem {
	status = "okay";
};

&ufsphy_mem {
	compatible = "qcom,ufs-phy-qmp-v4";
	status = "okay";
};

/* SD card slot (if present on TB371FC). TODO(dtbo#7): confirm cd-gpio. */
&sdhc_2 {
	vdd-supply = <&pm8150a_l9>;
	qcom,vdd-voltage-level = <2950000 2960000>;
	qcom,vdd-current-level = <200 800000>;

	vdd-io-supply = <&pm8150a_l6>;
	qcom,vdd-io-voltage-level = <1808000 2960000>;
	qcom,vdd-io-current-level = <200 22000>;

	pinctrl-names = "active", "sleep";
	pinctrl-0 = <&sdc2_clk_on &sdc2_cmd_on &sdc2_data_on>;
	pinctrl-1 = <&sdc2_clk_off &sdc2_cmd_off &sdc2_data_off>;

	/* TODO(dtbo#7): confirm card-detect GPIO and polarity */
	cd-gpios = <&tlmm 77 GPIO_ACTIVE_LOW>;

	status = "okay";
};

/* ------------------------------------------------------------------------
 * Serial console
 * ------------------------------------------------------------------------ */

&qupv3_se12_2uart {
	status = "okay";
};

/* ------------------------------------------------------------------------
 * USB / Type-C
 * ------------------------------------------------------------------------ */

&usb0 {
	status = "okay";

	dwc3@a600000 {
		maximum-speed = "super-speed-plus";
		/* TODO(dtbo#7): confirm dr_mode / role switch */
		dr_mode = "peripheral";
	};
};

&usb1 {
	qcom,default-mode-none;
	status = "okay";
};

&usb2_phy0 {
	status = "okay";
};

/* fsa4480 USB audio/DP switch.
 * TODO(dtbo#7): confirm I2C bus, address and GPIOs.
 */
&qupv3_se2_i2c {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	fsa4480: fsa4480@42 {
		compatible = "qcom,fsa4480";
		reg = <0x42>;
		status = "okay";
	};
};

/* ------------------------------------------------------------------------
 * Bluetooth / WiFi (QCA6390)
 * ------------------------------------------------------------------------ */

&vendor {
	bluetooth: bt_qca6390 {
		compatible = "qca,qca6390";
		pinctrl-names = "default";
		/* TODO(dtbo#7): confirm BT_EN/SW_CTRL GPIOs */
		pinctrl-0 = <&bt_en_sleep>;
		qca,bt-reset-gpio = <&tlmm 21 0>;
		qca,bt-sw-ctrl-gpio = <&tlmm 124 0>;
		qca,bt-vdd-aon-supply = <&pm8150_s6>;
		qca,bt-vdd-dig-supply = <&pm8009_s2>;
		qca,bt-vdd-rfa1-supply = <&pm8150_s5>;
		qca,bt-vdd-rfa2-supply = <&pm8150a_s8>;
		qca,bt-vdd-asd-supply = <&pm8150_l16>;
		status = "okay";
	};

	wlan: qcom,cnss-qca6390 {
		compatible = "qcom,cnss-qca6390";
		qcom,wlan-enabled;
		qcom,wlan-vreg-on = <&pm8150_l16>;
		qcom,antenna-chains = <2>;
		status = "okay";
	};
};

/* ------------------------------------------------------------------------
 * Display (Tianma NT36532 DSC 3K video panel)
 * ------------------------------------------------------------------------ */

/* Primary DSI display controller points to the TB371FC panel. */
&sde_dsi {
	qcom,dsi-default-panel = <&dsi_spinel_tianma_nt36532_dsc_3k_vid>;
	/* TODO(dtbo#7): confirm TE, reset GPIOs and regulator supplies */
	qcom,platform-te-gpio = <&tlmm 66 0>;
	qcom,panel-te-source = <0>;
	vdd-supply = <&pm8150a_l11>;
	vddio-supply = <&pm8150_l14>;
};

/* New panel node for TB371FC.
 * TODO(dtbo#7): replace timing/phy/porch values with the ones from
 * panel_spinel_tianma_nt36532_dsc_3k_video in stock dtbo #07.
 */
&soc {
	dsi_spinel_tianma_nt36532_dsc_3k_vid: qcom,mdss_dsi_spinel_tianma_nt36532_dsc_3k_video {
		compatible = "qcom,mdss-dsi-panel";
		label = "spinel tianma nt36532 dsc 3k video";
		qcom,mdss-dsi-panel-name = "spinel_tianma_nt36532_dsc_3k_video";
		qcom,mdss-dsi-panel-type = "dsi_video_mode";
		qcom,mdss-dsi-panel-framerate = <60>;
		qcom,mdss-dsi-panel-width = <2944>;
		qcom,mdss-dsi-panel-height = <1840>;
		qcom,mdss-dsi-panel-clockrate = <0>;
		qcom,mdss-dsi-virtual-channel-id = <0>;
		qcom,mdss-dsi-stream = <0>;
		qcom,mdss-dsi-panel-bpp = <24>;
		qcom,mdss-dsi-border-color = <0 0 0>;

		qcom,mdss-dsi-h-back-porch = <80>;
		qcom,mdss-dsi-h-pulse-width = <32>;
		qcom,mdss-dsi-h-front-porch = <160>;
		qcom,mdss-dsi-v-back-porch = <20>;
		qcom,mdss-dsi-v-pulse-width = <8>;
		qcom,mdss-dsi-v-front-porch = <40>;

		qcom,mdss-dsi-h-sync-skew = <0>;
		qcom,mdss-dsi-h-left-border = <0>;
		qcom,mdss-dsi-h-right-border = <0>;
		qcom,mdss-dsi-v-top-border = <0>;
		qcom,mdss-dsi-v-bottom-border = <0>;

		qcom,mdss-dsi-bpp = <24>;
		qcom,mdss-dsi-color-order = "rgb_swap_rgb";
		qcom,mdss-dsi-underflow-color = <0xff>;
		qcom,mdss-dsi-border-color = <0 0 0>;

		qcom,mdss-dsi-traffic-mode = "burst_mode";
		qcom,mdss-dsi-lane-map = "lane_map_0123";
		qcom,mdss-dsi-lane-0-state;
		qcom,mdss-dsi-lane-1-state;
		qcom,mdss-dsi-lane-2-state;
		qcom,mdss-dsi-lane-3-state;

		qcom,mdss-dsi-dma-trigger = "trigger_sw";
		qcom,mdss-dsi-mdp-trigger = "none";
		qcom,mdss-dsi-tx-eot-append;
		qcom,mdss-dsi-wr-mem-start = <0x2c>;
		qcom,mdss-dsi-wr-mem-continue = <0x3c>;

		qcom,mdss-dsi-panel-clockrate = <0>;
		qcom,mdss-dsi-panel-phy-timings = [00 22 05 05 23 22 05 05 04 02 04 00 1e 1d];
		qcom,mdss-dsi-panel-timings-phy-v2 = [1a 1f 05 06 03 02 04 a0
						      1a 1f 05 06 03 02 04 a0
						      1a 1f 05 06 03 02 04 a0
						      1a 1f 05 06 03 02 04 a0
						      1a 17 05 06 03 02 04 a0];

		/*
		 * TODO(dtbo#7) - 关键: 必须从原厂 dtbo #07 提取 NT36532 的
		 * DSI 初始化/下电命令序列, 否则面板不会点亮。
		 * 提取方法: dtc -I dtb -O dts dtbo.07 | grep -A2000 nt36532
		 */
		qcom,mdss-dsi-on-command = [];
		qcom,mdss-dsi-off-command = [];
		qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
		qcom,mdss-dsi-off-command-state = "dsi_hs_mode";

		qcom,mdss-dsi-dsc-enable;
		qcom,mdss-dsi-dsc-version = <0x11>;
		qcom,mdss-dsi-dsc-scr-version = <0x0>;
		qcom,mdss-dsi-slice-height = <20>;
		qcom,mdss-dsi-slice-width = <1472>;
		qcom,mdss-dsi-dsc-slice-per-pkt = <1>;
		qcom,mdss-dsi-dsc-bit-per-component = <8>;
		qcom,mdss-dsi-dsc-bit-per-pixel = <8>;

		qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";
		qcom,mdss-dsi-bl-min-level = <1>;
		qcom,mdss-dsi-bl-max-level = <4095>;
		qcom,mdss-brightness-max-level = <255>;

		qcom,platform-reset-gpio = <&tlmm 75 0>;
		qcom,platform-enable-gpio = <&tlmm 76 0>;

		qcom,mdss-dsi-display-timings {
			timing@0 {
				qcom,mdss-dsi-panel-width = <2944>;
				qcom,mdss-dsi-panel-height = <1840>;
				qcom,mdss-dsi-h-front-porch = <160>;
				qcom,mdss-dsi-h-back-porch = <80>;
				qcom,mdss-dsi-h-pulse-width = <32>;
				qcom,mdss-dsi-v-front-porch = <40>;
				qcom,mdss-dsi-v-back-porch = <20>;
				qcom,mdss-dsi-v-pulse-width = <8>;
				qcom,mdss-dsi-panel-framerate = <60>;
				qcom,mdss-dsi-panel-clockrate = <0>;
				qcom,mdss-dsi-panel-phy-timings = [00 22 05 05 23 22 05 05 04 02 04 00 1e 1d];
				qcom,display-topology = <1 1 1>, <2 2 1>;
				qcom,default-topology-index = <1>;
			};
		};
	};
};

/* ------------------------------------------------------------------------
 * Backlight (ktz8866a / ktz8866b)
 * TODO(dtbo#7): confirm I2C bus, address, enable/brightness GPIOs.
 * ------------------------------------------------------------------------ */
&qupv3_se4_i2c {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	backlight@2c {
		compatible = "kinetic,ktz8866a";
		reg = <0x2c>;
		status = "okay";
	};

	backlight_b@2d {
		compatible = "kinetic,ktz8866b";
		reg = <0x2d>;
		status = "okay";
	};
};

/* ------------------------------------------------------------------------
 * Touch (NVT-ts)
 * TODO(dtbo#7): confirm I2C bus, address, IRQ/reset GPIOs and supply rails.
 * ------------------------------------------------------------------------ */
&qupv3_se5_i2c {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	touchscreen@62 {
		compatible = "novatek,nt36532";
		reg = <0x62>;
		interrupt-parent = <&tlmm>;
		interrupts = <39 0x2008>;
		/* TODO(dtbo#7): replace with real IRQ/reset GPIOs */
		irq-gpios = <&tlmm 39 0x2008>;
		reset-gpios = <&tlmm 38 0x00>;
		vdd-supply = <&pm8150a_l1>;
		avdd-supply = <&pm8150_l13>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		/* TODO(dtbo#7): add correct pinctrl states */
		status = "okay";
	};
};

/* ------------------------------------------------------------------------
 * Sensors
 * TODO(dtbo#7): confirm I2C bus, addresses, IRQ GPIOs and supply rails.
 * ------------------------------------------------------------------------ */
&qupv3_se3_i2c {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	accelerometer@68 {
		compatible = "bosch,bmi323"; /* bmi3x0 family */
		reg = <0x68>;
		interrupt-parent = <&tlmm>;
		interrupts = <48 0x2>;
		status = "okay";
	};

	als@39 {
		compatible = "ams,tcs3408";
		reg = <0x39>;
		interrupt-parent = <&tlmm>;
		interrupts = <49 0x2>;
		status = "okay";
	};

	magnetometer@0d {
		compatible = "qst,qmc630x";
		reg = <0x0d>;
		status = "okay";
	};
};

/* ------------------------------------------------------------------------
 * Charger / Fuel gauge
 * TODO(dtbo#7): confirm I2C bus, address, IRQ GPIO and battery profile.
 * ------------------------------------------------------------------------ */
&qupv3_se7_i2c {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	charger@58 {
		compatible = "maxim,mm8013";
		reg = <0x58>;
		interrupt-parent = <&tlmm>;
		interrupts = <50 0x2>;
		status = "okay";
	};
};

/* ------------------------------------------------------------------------
 * Audio
 * Lenovo TB371FC uses tfa98xx amplifiers on the kona QRD audio path.
 * ------------------------------------------------------------------------ */
&dai_mi2s2 {
	qcom,msm-mi2s-tx-lines = <1>;
};

&kona_snd {
	qcom,model = "tb371fc-kona-snd-card";
	status = "okay";
};

/* ------------------------------------------------------------------------
 * Camera
 * TODO(dtbo#7): confirm CSI, I2C buses, reset/stby GPIOs, and regulators.
 * ------------------------------------------------------------------------ */
&soc {
	camera_front: qcom,camera@0 {
		compatible = "qcom,hi1339";
		reg = <0x0>;
		status = "okay";
	};

	camera_rear: qcom,camera@1 {
		compatible = "samsung,s5k4h7";
		reg = <0x1>;
		status = "okay";
	};
};

/* ------------------------------------------------------------------------
 * Fingerprint (goodix)
 * TODO(dtbo#7): confirm SPI/I2C bus, GPIOs and regulator.
 * ------------------------------------------------------------------------ */
&qupv3_se1_i2c {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	fingerprint@28 {
		compatible = "goodix,fp";
		reg = <0x28>;
		interrupt-parent = <&tlmm>;
		interrupts = <51 0x2>;
		status = "okay";
	};
};

/* ------------------------------------------------------------------------
 * GPIO keys
 * TODO(dtbo#7): confirm volume key GPIOs.
 * ------------------------------------------------------------------------ */
&soc {
	gpio_keys {
		compatible = "gpio-keys";
		label = "gpio-keys";

		pinctrl-names = "default";
		/* TODO(dtbo#7): add key pinctrl */

		vol_up {
			label = "volume_up";
			gpios = <&pm8150_gpios 6 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <KEY_VOLUMEUP>;
			gpio-key,wakeup;
			debounce-interval = <15>;
		};

		vol_down {
			label = "volume_down";
			gpios = <&pm8150_gpios 7 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <KEY_VOLUMEDOWN>;
			gpio-key,wakeup;
			debounce-interval = <15>;
		};
	};
};

/* ------------------------------------------------------------------------
 * Disable features not present on TB371FC
 * ------------------------------------------------------------------------ */

/* No secondary DSI on this tablet. */
&sde_dsi1 {
	status = "disabled";
};

/* No NFC on the WiFi-only variant (remove/keep per hardware variant). */
&wil6210 {
	status = "disabled";
};
